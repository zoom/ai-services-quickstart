# Required: Zoom Build Platform credentials with access to the APIs you use
ZOOM_API_KEY=
ZOOM_API_SECRET=

# Optional: server defaults for S3 batch jobs (credentials can also be supplied in the UI)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only when using temporary AWS credentials; refresh before they expire
AWS_SESSION_TOKEN=

# Optional: verify batch webhook signatures; match the secret submitted with the job
# Leave empty only when signature verification is not needed
WEBHOOK_SECRET=

# Local API / single-origin server port. Vite's dev proxy expects 4000.
# On Railway/Render, use the platform-provided PORT instead.
PORT=4000
